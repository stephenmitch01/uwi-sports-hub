PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key

# Database
DATABASE_URL=postgresql://postgres.your-project-ref:replace-with-your-database-password@your-supabase-pooler-host:6543/postgres

# Frontend origins allowed to call this API.
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:4000,http://127.0.0.1:4000,https://uwi-sports-hub.vercel.app

# Invite-only account creation.
ACCOUNT_INVITE_CODE=replace-with-a-private-invite-code
FIRST_ADMIN_EMAIL=replace-with-your-admin-email
